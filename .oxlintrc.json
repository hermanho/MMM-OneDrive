{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["MMM-OneDrive.js", "**/*.d.ts", "lib/**/*.js"],
  "plugins": ["typescript", "jsdoc"],
  "jsPlugins": ["eslint-plugin-tsdoc"],
  "env": { "browser": true, "node": true },
  "globals": {
    "Log": "readonly",
    "MM": "readonly",
    "Module": "readonly",
    "define": "readonly",
    "PhotosConverter": "readonly"
  },
  "rules": {
    "eqeqeq": "error",
    "no-prototype-builtins": "off",
    "no-useless-return": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-promise-reject-errors": "error",
    "require-await": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-unnecessary-template-expression": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.mts", "**/*.cts"],
      "rules": { "tsdoc/syntax": "error" }
    },
    {
      "files": ["**/*.test.ts", "tests/**", "src/backend/functions/photosConverter.ts", "src/backend/functions/externals/libheifJS.ts"],
      "rules": { "typescript/no-explicit-any": "off" }
    },
    {
      "files": ["**/*.js", "**/*.mjs"],
      "rules": {
        "jsdoc/check-tag-names": "warn",
        "jsdoc/check-property-names": "warn",
        "jsdoc/empty-tags": "warn",
        "jsdoc/require-param": "warn",
        "jsdoc/require-param-name": "warn",
        "jsdoc/require-param-type": "warn",
        "jsdoc/require-returns-description": "warn",
        "jsdoc/require-returns-type": "warn"
      }
    }
  ]
}
