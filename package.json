{
  "name": "mmm-onedrive",
  "version": "1.9.3",
  "description": "MagicMirror² module to display your photos from OneDrive.",
  "license": "MIT",
  "author": "hermanho",
  "main": "MMM-OneDrive.js",
  "contributors": [
    "https://github.com/hermanho/MMM-OneDrive/graphs/contributors"
  ],
  "scripts": {
    "build": "rolldown -c",
    "install-prod": "npm install --no-audit --no-fund --no-update-notifier --only=prod --omit=dev",
    "lint": "oxlint . --fix",
    "lint:ci": "oxlint . --deny-warnings",
    "typecheck:frontend": "tsc -p src/frontend/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hermanho/MMM-OneDrive"
  },
  "bugs": {
    "url": "https://github.com/hermanho/MMM-OneDrive/issues"
  },
  "keywords": [
    "MagicMirror",
    "OneDrive"
  ],
  "dependencies": {
    "@azure/msal-node": "6.0.1",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "dayjs": "1.11.23",
    "heic-convert": "2.1.0",
    "image-type": "6.1.0",
    "libheif-js": "1.23.5",
    "re2-wasm": "1.0.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@microsoft/microsoft-graph-types": "2.43.1",
    "@types/magicmirror-module": "2.16.6",
    "eslint-plugin-tsdoc": "0.5.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rolldown": "1.2.16",
    "rolldown-plugin-dts": "0.29.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.22.2 <23 || >=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
