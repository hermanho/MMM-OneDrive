{
  "name": "mmm-onedrive",
  "version": "1.9.3",
  "description": "MagicMirror² module to display your photos from OneDrive.",
  "license": "MIT",
  "author": "hermanho",
  "main": "MMM-OneDrive.js",
  "contributors": [
    "https://github.com/hermanho/MMM-OneDrive/graphs/contributors"
  ],
  "scripts": {
    "build": "rollup -c",
    "install-prod": "npm install --no-audit --no-fund --no-update-notifier --only=prod --omit=dev",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hermanho/MMM-OneDrive"
  },
  "bugs": {
    "url": "https://github.com/hermanho/MMM-OneDrive/issues"
  },
  "keywords": [
    "MagicMirror",
    "OneDrive"
  ],
  "dependencies": {
    "@azure/msal-node": "6.0.1",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "dayjs": "1.11.23",
    "heic-convert": "2.1.0",
    "image-type": "6.1.0",
    "libheif-js": "1.23.2",
    "re2-wasm": "1.0.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@microsoft/microsoft-graph-types": "2.43.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-strip": "3.0.4",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/magicmirror-module": "2.16.6",
    "eslint-plugin-jsdoc": "64.3.8",
    "eslint-plugin-tsdoc": "0.5.2",
    "globals": "17.12.0",
    "rollup": "4.63.3",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.21.1 <23 || >=24"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
